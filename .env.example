# Copy to .env (repo root) for backend + infra. NEVER commit .env.
# Frontend values go in frontend/.env.local (see bottom). See README.md.

# ---- AWS ----
AWS_PROFILE=hackathon
AWS_REGION=ap-south-1

# ---- AI model (backend/src/lib/ai.ts; see README "Choosing the AI model") ----
# AI_PROVIDER: claude-bedrock (default) | bedrock-converse | openai-compatible
AI_PROVIDER=claude-bedrock
# claude-bedrock:    anthropic.claude-opus-5-5 | anthropic.claude-sonnet-5-5 | anthropic.claude-haiku-5-5
# bedrock-converse:  a Bedrock model id with image input, e.g. an Amazon Nova id from the Bedrock console
# openai-compatible: the endpoint's model name, e.g. a vision model pulled into Ollama
AI_MODEL_ID=anthropic.claude-opus-5-5
# Bedrock providers only. Empty = AWS_REGION. Set us-east-1 if the model isn't offered in ap-south-1.
AI_REGION=
# claude-bedrock only, optional: low | medium | high (lower = cheaper; Opus 5.5 defaults to medium)
AI_EFFORT=
# openai-compatible only: base URL ending in /v1 (Ollama: http://localhost:11434/v1). Key only if the endpoint needs one.
AI_BASE_URL=
AI_API_KEY=

# From `npm run deploy -w infra` outputs
TABLE_NAME=
BUCKET_NAME=

# Comma-separated origins allowed by the Lambda Function URL and S3 CORS
ALLOWED_ORIGINS=http://localhost:5173

# ---- ElevenLabs (server-side only; never in the frontend) ----
ELEVENLABS_API_KEY=
# Current Scribe speech-to-text model id (check ElevenLabs docs)
ELEVENLABS_STT_MODEL=
# A TTS model that supports Hindi + Kannada (verify in docs)
ELEVENLABS_TTS_MODEL=
ELEVENLABS_VOICE_ID=


# ---- Frontend: put these in frontend/.env.local (public values only) ----
# VITE_API_BASE_URL=http://localhost:3001
# VITE_ELEVENLABS_AGENT_ID=
